// Top-level bindings are for local development. Use a named environment for releases.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopiflare",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopiflare-shopify-app-db-dev",
      "database_id": "<your-dev-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SHOPIFY_API_KEY": "<your-dev-client-id>",
    "SCOPES": "write_products",
    "ENVIRONMENT": "local",
    "SHOPIFY_APP_URL": "http://localhost:3000",
    "SHOP_CUSTOM_DOMAIN": ""
  },
  "env": {
    "development": {
      "name": "shopiflare-development",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shopiflare-shopify-app-db-dev",
          "database_id": "<your-dev-database-id>",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SHOPIFY_APP_URL": "https://shopiflare-development.<your-account>.workers.dev",
        "SHOPIFY_API_KEY": "<your-dev-client-id>",
        "SCOPES": "write_products",
        "ENVIRONMENT": "development",
        "SHOP_CUSTOM_DOMAIN": ""
      },
      "version_metadata": {
        "binding": "VERSION_METADATA"
      },
      "secrets": {
        "required": [
          "SHOPIFY_API_SECRET"
        ]
      }
    },
    "production": {
      "name": "shopiflare",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shopiflare-shopify-app-db-prod",
          "database_id": "<your-production-database-id>",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SHOPIFY_APP_URL": "https://shopiflare.<your-account>.workers.dev",
        "SHOPIFY_API_KEY": "<your-production-client-id>",
        "SCOPES": "write_products",
        "ENVIRONMENT": "production",
        "SHOP_CUSTOM_DOMAIN": ""
      },
      "version_metadata": {
        "binding": "VERSION_METADATA"
      },
      "secrets": {
        "required": [
          "SHOPIFY_API_SECRET"
        ]
      }
    }
  },
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "secrets": {
    "required": [
      "SHOPIFY_API_SECRET"
    ]
  }
}
