/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopiflare",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // Top-level = local dev defaults
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopify-app-db",
      "database_id": "<your-dev-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SCOPES": "write_products"
  },
  "env": {
    "staging": {
      "name": "shopiflare-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shopify-app-db-staging",
          "database_id": "<your-staging-database-id>",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SHOPIFY_APP_URL": "https://shopiflare-staging.<your-account>.workers.dev",
        "SCOPES": "write_products"
      }
    },
    "production": {
      "name": "shopiflare",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shopify-app-db",
          "database_id": "<your-production-database-id>",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SHOPIFY_APP_URL": "https://shopiflare.<your-account>.workers.dev",
        "SCOPES": "write_products"
      }
    }
  }
}