{
  "name": "shopiflare",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "build:dev": "cross-env CLOUDFLARE_ENV=development npm run build",
    "build:prod": "cross-env CLOUDFLARE_ENV=production npm run build",
    "cf:types": "wrangler types --strict-vars=false",
    "check": "npm run typecheck && npm test",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc --env development",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc --env production",
    "deploy:dev": "npm run preflight:dev && npm run check && npm run build:dev && node scripts/check-release.mjs development --built && wrangler deploy",
    "deploy:prod": "npm run preflight:prod && npm run check && npm run build:prod && node scripts/check-release.mjs production --built && wrangler deploy",
    "deploy:shopify:dev": "npm run preflight:dev && shopify app deploy --config shopify.app.development.toml --allow-updates",
    "deploy:shopify:prod": "npm run preflight:prod && shopify app deploy --config shopify.app.toml --allow-updates",
    "dev": "shopify app dev --config shopify.app.development.toml",
    "dev:cf": "react-router dev",
    "env": "shopify app env",
    "generate": "shopify app generate",
    "graphql-codegen": "graphql-codegen",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "preflight:dev": "node scripts/check-release.mjs development",
    "preflight:prod": "node scripts/check-release.mjs production",
    "shopify": "shopify",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "typecheck": "npm run cf:types && react-router typegen && tsc --noEmit",
    "vite": "vite"
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "dependencies": {
    "@react-router/dev": "7.18.3",
    "@react-router/fs-routes": "7.18.3",
    "@react-router/node": "7.18.3",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "14.0.1",
    "@shopify/shopify-app-react-router": "2.1.0",
    "@shopify/shopify-app-session-storage": "6.0.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.3",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "2.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "jsonc-parser": "3.3.1",
    "prettier": "^3.6.2",
    "smol-toml": "1.7.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.129.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": ""
}
